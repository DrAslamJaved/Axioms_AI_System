# Keep secrets out of version control. The system runs fully without an LLM key.

# --- Storage ---
AXIOMS_DATABASE_URL=sqlite:///data/axioms.sqlite3

# --- Authentication ---
# Set a strong value to require the X-API-Key header on all state-changing
# endpoints. If left blank the API runs in OPEN DEVELOPMENT mode (reported by
# GET /health as auth=open-dev). Production must set this.
AXIOMS_API_KEY=

# --- Approval policy ---
# strict     : every draft requires a human approval checkpoint (default).
# risk_based : low-risk internal drafts are planned directly; external and
#              sensitive requests still require approval.
AXIOMS_APPROVAL_MODE=strict

# --- Local execution resource budget ---
# Maximum local draft threads when a caller explicitly uses ?parallel=true.
# Valid values: 1–4. Default: 2. This never enables external actions.
AXIOMS_MAX_PARALLEL_WORKERS=2

# --- LLM provider (optional; agentic synthesis) ---
# disabled | anthropic | openai. Leave disabled to run the deterministic system.
AXIOMS_LLM_PROVIDER=disabled
# Exact model id for the chosen provider (verify against the provider's docs).
AXIOMS_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tools ---
# Optional contact address included in Crossref API requests (good etiquette).
CROSSREF_MAILTO=
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
