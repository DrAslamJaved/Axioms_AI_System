# Keep secrets out of version control. The system runs fully without an LLM key.

# --- Storage ---
AXIOMS_DATABASE_URL=sqlite:///data/axioms.sqlite3

# --- Authentication ---
# Set a strong value to require the X-API-Key header on protected endpoints.
# If left blank the API runs in OPEN DEVELOPMENT mode. Production must set this.
AXIOMS_API_KEY=

# Optional named-key mode. Legacy entries map every named principal to the
# administrator role: {"Dr Aslam": "legacy-secret"}. Prefer role-bearing
# entries in production. viewer keys cannot make approval or memory-governance
# decisions; approver keys may make those reviewed decisions; only admin keys
# may override a HIGH-risk data-governance block.
# AXIOMS_API_KEYS={"Dr Aslam":{"secret":"replace-me","role":"admin"},"Reviewer":{"secret":"replace-me","role":"approver"},"Observer":{"secret":"replace-me","role":"viewer"}}
AXIOMS_API_KEYS=

# Keep false for isolated local development. Set true in any deployed
# environment; protected operations then fail closed until a key is configured.
AXIOMS_REQUIRE_AUTH=false

# Generated OpenAPI schema and interactive docs are disabled by default. Set to
# true only for a local, trusted development session; never expose them publicly.
AXIOMS_ENABLE_API_DOCS=false

# --- Approval policy ---
# strict     : every draft requires a human approval checkpoint (default).
# risk_based : low-risk internal drafts are planned directly; external and
#              sensitive requests still require approval.
AXIOMS_APPROVAL_MODE=strict

# --- Local execution resource budget ---
# Maximum local draft threads when a caller explicitly uses ?parallel=true.
# Valid values: 1–4. Default: 2. This never enables external actions.
AXIOMS_MAX_PARALLEL_WORKERS=2

# --- LLM provider (optional; agentic synthesis) ---
# disabled | anthropic | openai. Leave disabled to run the deterministic system.
AXIOMS_LLM_PROVIDER=disabled
# Exact model id for the chosen provider (verify against the provider's docs).
AXIOMS_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tools ---
# Optional contact address included in Crossref API requests (good etiquette).
CROSSREF_MAILTO=
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
